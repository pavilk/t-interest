# Скопируй в .env и поменяй значения. .env в git не коммитится.
DATABASE_URL=postgresql+asyncpg://tinterest:tinterest@localhost:5432/tinterest
POSTGRES_DB=tinterest
POSTGRES_USER=tinterest
POSTGRES_PASSWORD=tinterest
POSTGRES_PORT=5432
# Отдельная временная БД для pytest -m postgres (compose profile test)
TEST_DATABASE_URL=postgresql+asyncpg://tinterest_test:tinterest_test@localhost:5433/tinterest_test
TEST_POSTGRES_PORT=5433
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
# Домены почты, с которых разрешена регистрация, через запятую
ALLOWED_EMAIL_DOMAINS=example.com
