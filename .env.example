# Скопируй в .env и поменяй значения. .env в git не коммитится.
DATABASE_URL=postgresql+asyncpg://tinterest:tinterest@localhost:5432/tinterest
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
# Домены почты, с которых разрешена регистрация, через запятую
ALLOWED_EMAIL_DOMAINS=example.com
# Чат: тайминги WebSocket (секунды) и лимит сообщений на пользователя
WS_AUTH_TIMEOUT_SECONDS=5
WS_IDLE_TIMEOUT_SECONDS=60
WS_MAX_CONNECTIONS_PER_USER=5
WS_SEND_QUEUE_SIZE=100
CHAT_RATE_PER_SECOND=5
CHAT_RATE_BURST=10
